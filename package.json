{
  "name": "douglasgreen_php-linter",
  "version": "1.0.0",
  "description": "Code linter for PHP based on Nikic parser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:md && prettier --check .",
    "lint:md": "markdownlint \"**/*.md\"",
    "format": "prettier --write . && markdownlint \"**/*.md\" --fix"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49",
    "prettier": "^3.9"
  }
}
